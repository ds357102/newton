# Newton — local config
# Copy to .env and fill in only what you actually need.
# Newton works with NOTHING set; it falls back to rules-only scoring + stub drafts.

# ---- Recommended ----
# Anthropic key — turns on LLM classification + outreach drafting.
# Without it, Newton uses rules-only scoring. ~$0.001-0.003 per item with Haiku.
ANTHROPIC_API_KEY=

# ---- Optional ----
# How often the streamer worker runs (seconds). Default 900 = 15 min.
NEWTON_STREAM_INTERVAL_SEC=900

# Persist hit cache to disk so it survives restarts.
NEWTON_PERSIST_HITS=1

# Point at a custom prospects file (otherwise uses newton/data/prospects.json)
# NEWTON_PROSPECTS_FILE=/path/to/my-prospects.json

# ---- Free tier sources ----
# Google News RSS:        no key, unlimited — runs by default in the streamer.
# Industry RSS:           no key — add feeds in the streamer when you want them.
# Reddit RSS (search):    no key needed at low volume; PRAW vars below give higher rate limits.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=newton/0.6 by you

# YouTube Data API v3 — free tier 10k units/day, ~100 searches/day.
# Create one at https://console.cloud.google.com → APIs & Services → Credentials
# YOUTUBE_API_KEY=

# ---- Paid (not used; here only if you ever turn them on) ----
# X (Twitter) API — basic tier $100/mo. Skip unless you have a real need.
# X_BEARER_TOKEN=
# LinkedIn — partner-program only.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ---- Infrastructure (only needed if you run docker-compose) ----
# DATABASE_URL=postgresql+asyncpg://newton:newton@db:5432/newton
# REDIS_URL=redis://redis:6379/0
